---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact" description="Get in touch with Millbrooke to tailor a cleaning and facility management programme for your business.">

<main>
<section class="relative isolate overflow-hidden bg-primary py-32 pt-40 text-white lg:py-40 lg:pt-48">
  <div class="absolute inset-0 -z-10 bg-cover bg-center opacity-20" style="background-image:url('/assets/people-culture.jpg')"></div>
  <div class="absolute inset-0 -z-10 bg-gradient-to-br from-primary via-[#192e47f2] to-[#192e47cc]"></div>
  <div class="mx-auto max-w-7xl px-6 lg:px-10">
    <div class="mb-fade">
      <nav class="flex items-center gap-2 text-[11px] uppercase tracking-[0.32em] text-white/70">
        <a href="/" class="hover:text-white">Home</a><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg><span class="text-white">Contact</span>
      </nav>
    </div>
    <div class="mt-16 grid gap-16 lg:grid-cols-12">
      <div class="lg:col-span-5 mb-fade">
        <p class="text-xs uppercase tracking-[0.42em] text-white/60">Contact</p>
        <h1 class="mt-6 text-4xl font-semibold leading-tight tracking-tight md:text-5xl lg:text-6xl">Let's tailor a programme to your facility.</h1>
        <p class="mt-6 text-base leading-relaxed text-white/75">Tell us about your business and we'll be in touch to design a cleaning and facility management plan that fits.</p>
        <div class="mt-12 space-y-5 border-t border-white/15 pt-8 text-sm text-white/80">
          <a href="mailto:admin@millbrooke.com.au" class="flex items-center gap-4 hover:text-white"><span class="flex h-10 w-10 items-center justify-center rounded-full border border-white/20"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg></span>admin@millbrooke.com.au</a>
          <div class="flex items-center gap-4"><span class="flex h-10 w-10 items-center justify-center rounded-full border border-white/20"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg></span>Sydney, Australia — servicing facilities Sydney-wide</div>
        </div>
      </div>
      <div class="lg:col-span-7 mb-fade" data-delay="120">
    <form id="contact-form" class="mb-fade rounded-sm border border-white/15 bg-white/5 p-8 backdrop-blur lg:p-10">
  <p class="hidden">
    <label>Don't fill this out if you're human: <input name="bot-field" /></label>
  </p>

  <div class="grid gap-6 md:grid-cols-2">
    <div>
      <label class="text-[11px] font-semibold uppercase tracking-[0.32em] text-white/70">Name</label>
      <input class="mt-3 mb-field" type="text" name="name" maxlength="255" required>
    </div>
    <div>
      <label class="text-[11px] font-semibold uppercase tracking-[0.32em] text-white/70">Email Address</label>
      <input class="mt-3 mb-field" type="email" name="email" maxlength="255" required>
    </div>
  </div>

  <div class="mt-6 grid gap-6 md:grid-cols-2">
    <div>
      <label class="text-[11px] font-semibold uppercase tracking-[0.32em] text-white/70">Phone</label>
      <input class="mt-3 mb-field" type="tel" name="phone" maxlength="255" required>
    </div>
    <div>
      <label class="text-[11px] font-semibold uppercase tracking-[0.32em] text-white/70">Company</label>
      <input class="mt-3 mb-field" type="text" name="company" maxlength="255">
    </div>
  </div>

  <div class="mt-6">
    <label class="text-[11px] font-semibold uppercase tracking-[0.32em] text-white/70">Service</label>
    <select class="mt-3 mb-field" name="service" required>
      <option value="" disabled selected>Select a service</option>
      <option value="Commercial Cleaning">Commercial Cleaning</option>
      <option value="Compliance &amp; Standards">Compliance &amp; Standards</option>
      <option value="Green Cleaning &amp; Management">Green Cleaning &amp; Management</option>
      <option value="People &amp; Culture">People &amp; Culture</option>
      <option value="Facility Management">Facility Management</option>
      <option value="Other">Other</option>
    </select>
  </div>

  <div class="mt-6">
    <label class="text-[11px] font-semibold uppercase tracking-[0.32em] text-white/70">Message</label>
    <textarea required name="message" rows="5" maxlength="1000" class="mt-3 mb-field"></textarea>
  </div>

  <div class="cf-turnstile mt-8" data-sitekey="0x4AAAAAAD8iKJKaTFd_kSDH" data-theme="dark"></div>

  <button type="submit" class="group mt-10 inline-flex items-center gap-3 rounded-full bg-white px-8 py-4 text-xs font-semibold uppercase tracking-[0.28em] text-primary transition-all hover:shadow-2xl">Send Enquiry <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg></button>
</form>
      </div>
    </div>
  </div>
</section>
</main>

</Layout>